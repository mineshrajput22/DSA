{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Current TypeScript File",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx.cmd",
      "runtimeArgs": ["${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
